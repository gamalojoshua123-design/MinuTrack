# Minute Burger POS - environment configuration
# Copy this file to ".env" (same folder) and fill in your real values.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
#
# .env is git-ignored and never committed. Do NOT commit real keys.

# Database Configuration
# DB_HOST=localhost
# DB_NAME=pos_system
# DB_USER=root
# DB_PASS=

# Groq API key - used by the AI Assistant
# Get one at https://console.groq.com/keys  (login > API Keys > Create)
# GROQ_API_KEY=your_groq_api_key_here

# URL path the app is served from. Auto-detected - only set this if pages
# load without CSS (e.g. symlinked folder or Apache Alias). Use / for a domain root.
# APP_BASE_PATH=/minute1/